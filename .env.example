# ---- Required ----
# Postgres connection string. With docker compose the app container uses the `db` service.
DATABASE_URL=postgres://calendly:calendly@localhost:5432/calendly
# Public URL of this deployment (no trailing slash). Used in emails and OAuth callbacks.
APP_URL=http://localhost:3000
# Random 32+ char secret for session signing: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# ---- Email (SMTP) ----
# Any SMTP provider works: Gmail app password, Mailgun, SES, Postmark, your own server.
# When the app itself runs in Docker and you use the bundled Mailpit (`docker compose --profile dev up`),
# set SMTP_HOST=mailpit (localhost inside the container is the container itself).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS)
SMTP_SECURE=false
EMAIL_FROM="Scheduling <noreply@example.com>"

# ---- Google (optional: sign-in with Google + Google Calendar sync) ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Serverless hosts only (Vercel etc.) ----
# On Vercel the background job workers can't stay alive, so a scheduler must call
# GET /api/jobs/run every minute instead. That endpoint requires this secret
# (`openssl rand -hex 32`). Vercel Cron sends it automatically; see docs/self-hosting.md.
# CRON_SECRET=

# ---- Postgres container (docker compose only) ----
POSTGRES_USER=calendly
POSTGRES_PASSWORD=calendly
POSTGRES_DB=calendly
